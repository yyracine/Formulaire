# ---------------------------------------------------------------------------
# Configuration de l'envoi d'e-mail (Resend - https://resend.com)
# Copiez ce fichier en .env (local) et/ou renseignez ces variables dans
# le tableau de bord de votre hebergeur (Vercel / Netlify / Cloudflare Pages).
# ---------------------------------------------------------------------------

# Cle API Resend (commence par re_). Creez-la sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Boite mail qui recoit les questionnaires (votre adresse)
MAIL_TO=vous@votre-domaine.fr

# Expediteur. En test, "onboarding@resend.dev" fonctionne sans domaine verifie
# (l'envoi est alors limite a l'adresse du compte Resend).
# En production, utilisez une adresse de votre domaine verifie.
MAIL_FROM=Questionnaire Site <onboarding@resend.dev>

# Prefixe du sujet des e-mails (optionnel)
MAIL_SUBJECT_PREFIX=[Questionnaire site]

# Le nom du fichier Markdown joint (optionnel)
MAIL_ATTACHMENT_NAME=questionnaire.md
